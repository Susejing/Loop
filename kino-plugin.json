{
  "id": "loop",
  "name": "Loop - TikTok",
  "author": "Susejing",
  "version": "0.4.0",
  "icon": "icon.png",
  "description": "TikTok en Kino: tendencias por pais, busqueda y enlaces. Sin marca de agua.",
  "apiVersion": 11,
  "entry": "plugin.js",
  "hosts": [
    "tikwm.com",
    "www.tikwm.com",
    "*.tiktokcdn.com",
    "*.tiktokcdn-us.com",
    "*.tiktokv.us",
    "*.tiktokv.com"
  ],
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve"
  ],
  "theme": {
    "accent": "#25F4EE",
    "onAccent": "#00252B",
    "background": "#0A0A0A",
    "surface": "#18181F",
    "highlight": "#F5F5F7"
  },
  "enhancements": {
    "20": {
      "visualBrowser": true
    }
  },
  "settings": [
    {
      "key": "marca",
      "label": "Marca de agua",
      "type": "select",
      "default": "no",
      "options": [
        { "value": "no", "label": "Sin marca de agua (recomendado)" },
        { "value": "si", "label": "Con marca de agua" }
      ]
    },
    {
      "key": "estado",
      "label": "Estado",
      "type": "status"
    },
    {
      "key": "verificacion",
      "label": "Pasar verificacion",
      "type": "action",
      "hint": "Solo para #hashtags y @perfiles.",
      "confirm": "Se abrira tikwm.com. Espera a que cargue y toca Listo."
    }
  ],
  "color": "#FE2C55",
  "debug": false
}
